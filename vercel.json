{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/monitor.html", "destination": "/web/monitor.html" },
    { "source": "/guide.html", "destination": "/web/guide.html" },
    { "source": "/(.*)", "destination": "/web/$1" }
  ]
}
